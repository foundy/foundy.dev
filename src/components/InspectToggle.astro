---
/**
 * Inspect entry point. The button is plain static HTML (visible on every viewport); src/lib/inspect/toggle.ts wires
 * it and loads the Inspect chunk on first use. */
---

<button type="button" class="inspect" data-inspect-toggle aria-pressed="false" aria-keyshortcuts="I">
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
    <rect x="1.5" y="1.5" width="13" height="13" fill="none" stroke="currentColor" stroke-dasharray="2 2"></rect>
    <path d="M5 8h6M8 5v6" stroke="currentColor" fill="none"></path>
  </svg>
  <span>Inspect</span>
  <kbd class="key" aria-hidden="true">I</kbd>
</button>

<style>
  .inspect {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0.45em 0.9em;
    border: 1px dashed var(--bp-line-on-paper);
    background: transparent;
    color: var(--bp-line-on-paper);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.3;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }
  .inspect:hover {
    background: color-mix(in srgb, var(--bp-line-on-paper) 10%, transparent);
  }
  .inspect[aria-pressed='true'] {
    border-style: solid;
    background: var(--bp-line-on-paper);
    color: var(--paper);
  }
  .key {
    padding: 0 0.4em;
    border: 1px solid currentColor;
    border-radius: 2px;
    font: inherit;
    font-size: 0.85em;
    opacity: 0.75;
  }
  @media (hover: none) {
    .key {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .inspect {
      transition: none;
    }
  }
</style>
