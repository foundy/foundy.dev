---
/**
 * Layout for the phase 2 hero spike pages. Deliberately separate from Base:
 * noindex, no nav, no footer, no canonical/OG. Not linked from anywhere.
 */
import '../styles/global.css';

interface Props {
  title: string;
  variant: 'raw' | 'three';
}
const { title, variant } = Astro.props;
const stages = ['sdf', 'warp', 'flow', 'composite'];
const looks = ['ink', 'refract', 'riso'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="spike">
      <p class="label">spike / {variant} &middot; ?stage=sdf|warp|flow|composite &middot; ?look=ink|refract|riso &middot; ?hud=1 &middot; ?dpr=1.5 &middot; ?gl=webgl2 &middot; ?bench=1</p>
      <div class="stage">
        <canvas id="gl" aria-hidden="true"></canvas>
        <pre id="hud" class="hud" aria-hidden="true"></pre>
      </div>
      <nav class="links" aria-label="spike variants">
        {stages.map((s) => <a href={`?stage=${s}&hud=1`}>{s}</a>)}
        {looks.map((l) => <a href={`?look=${l}&hud=1`}>{l}</a>)}
      </nav>
    </main>
    <slot />
  </body>
</html>

<style is:global>
  .spike {
    padding: var(--gutter);
    display: grid;
    gap: var(--space-s);
  }
  .spike .label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-muted);
    margin: 0;
  }
  .spike .stage {
    position: relative;
  }
  #gl {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 520;
    touch-action: none;
    background: var(--paper);
  }
  @media (max-width: 600px) {
    #gl {
      aspect-ratio: 390 / 420;
    }
  }
  .hud {
    position: absolute;
    left: 8px;
    bottom: 8px;
    margin: 0;
    padding: 6px 8px;
    font: 11px/1.35 var(--font-mono);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    color: var(--ink);
    border: 1px solid var(--rule);
    pointer-events: none;
    white-space: pre;
  }
  .spike .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
