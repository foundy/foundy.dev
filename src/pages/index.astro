---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroPoster from '../components/HeroPoster.astro';
import WorkVisual from '../components/WorkVisual.astro';
import { about, contact, now, site } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <main id="main">
    <h1 class="visually-hidden">{site.name}: {site.role}</h1>

    <section class="hero wrap" aria-label="Introduction">
      <HeroPoster />
      <div class="hero-meta grid">
        <p class="statement">{site.role}</p>
        <dl class="facts">
          <div>
            <dt class="label">Focus</dt>
            <dd>{site.focus}</dd>
          </div>
          <div>
            <dt class="label">Based</dt>
            <dd>{site.location}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="work" class="section wrap" aria-labelledby="work-h">
      <header class="section-head">
        <h2 id="work-h" class="label">Selected work</h2>
        <span class="label">({String(work.length).padStart(2, '0')})</span>
      </header>

      {
        work.map((entry, i) => (
          <article class:list={['entry', i % 2 === 1 && 'flip']} data-card={entry.id}>
            <a
              class="entry-visual"
              href={`/work/${entry.id}`}
              tabindex="-1"
              aria-hidden="true"
              data-card-trigger
            >
              <WorkVisual slug={entry.id} vtName={`work-visual-${entry.id}`} />
              <span class="peek mono" aria-hidden="true">Quick look</span>
            </a>
            <div class="entry-text">
              <p class="label">
                {String(i + 1).padStart(2, '0')} / {entry.data.year}{' '}
                {entry.data.mock && <span class="badge">Mock</span>}
              </p>
              <h3 style={`view-transition-name: work-title-${entry.id}`}>
                <a href={`/work/${entry.id}`} data-card-trigger data-card-title>
                  {entry.data.title}
                </a>
              </h3>
              <p class="summary">{entry.data.summary}</p>
              <dl class="meta">
                <div>
                  <dt class="label">Role</dt>
                  <dd>{entry.data.role}</dd>
                </div>
                <div>
                  <dt class="label">Stack</dt>
                  <dd class="mono">{entry.data.stack.join(', ')}</dd>
                </div>
              </dl>
              <a class="more mono" href={`/work/${entry.id}`}>
                Read the case study <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))
      }

      <p class="lab-link">
        <a class="mono" href="/lab">Four card-study decisions, replayed old rule vs new, in the Lab <span aria-hidden="true">&rarr;</span></a>
      </p>
    </section>

    <section id="about" class="section wrap" aria-labelledby="about-h">
      <header class="section-head">
        <h2 id="about-h" class="label">About</h2>
      </header>
      <div class="split grid">
        <p class="lede">{about.lede}</p>
        <div class="body">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <dl class="skills">
          {
            about.skills.map(([k, v]) => (
              <div>
                <dt class="label">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="now grid" aria-labelledby="now-h">
        <h3 id="now-h" class="label now-title">Now</h3>
        <ul class="now-list">
          {
            now.items.map(([k, v]) => (
              <li>
                <span class="label">{k}</span>
                <span>{v}</span>
              </li>
            ))
          }
        </ul>
        <p class="mono now-date">Updated <time datetime={now.updatedAt}>{now.updatedAt}</time></p>
      </div>
    </section>

    <section id="contact" class="section wrap" aria-labelledby="contact-h">
      <header class="section-head">
        <h2 id="contact-h" class="label">Contact</h2>
      </header>
      <div class="split grid contact">
        <a class="email" href={`mailto:${contact.email}`}>{contact.email}</a>
        <p class="note">{contact.note}</p>
        <ul class="socials">
          {
            contact.socials.map((s) => (
              <li>
                <a href={s.href} rel="me noopener">
                  <span>{s.label}</span>
                  <span class="mono">{s.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

    <div id="cards-layer" class="cards-layer" data-cards-layer>
      <div id="work-sheet" class="sheet-dialog" role="dialog" aria-modal="true" hidden>
        <div class="sheet-scrim" data-scrim></div>
        <div class="sheet" data-sheet>
          <div class="sheet-bg" data-fade></div>
          <div class="sheet-scroll" data-scroll></div>
          <div class="sheet-bar" data-fade>
            <button type="button" class="sheet-btn" data-inspect-toggle aria-pressed="false" aria-keyshortcuts="I">
              <span>Inspect</span>
            </button>
            <button type="button" class="sheet-btn sheet-close" data-sheet-close aria-label="Close preview">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" fill="none"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
      <div class="cards-dock" data-inspect-dock></div>
      <svg class="cards-overlay" data-inspect-overlay aria-hidden="true" style="display:none"></svg>
      {
        work.map((entry, i) => (
          <template data-sheet-for={entry.id}>
            <div class="sh">
              <p class="label sh-meta">
                {String(i + 1).padStart(2, '0')} / {entry.data.year}{' '}
                {entry.data.mock && <span class="badge">Mock</span>}
              </p>
              <h2 class="sh-title" tabindex="-1" data-sheet-title>
                {entry.data.title}
              </h2>
              <div class="sh-hero" data-sheet-hero>
                <WorkVisual slug={entry.id} variant="-sheet" />
              </div>
              <div class="sh-text">
                <p class="sh-summary">{entry.data.summary}</p>
                <dl class="sh-facts">
                  {entry.data.facts.map((f) => (
                    <div>
                      <dt class="label">{f.label}</dt>
                      <dd>{f.value}</dd>
                    </div>
                  ))}
                </dl>
                {entry.data.preview.map((p) => <p class="sh-p">{p}</p>)}
                <dl class="sh-meta2">
                  <div>
                    <dt class="label">Role</dt>
                    <dd>{entry.data.role}</dd>
                  </div>
                  <div>
                    <dt class="label">Stack</dt>
                    <dd class="mono">{entry.data.stack.join(', ')}</dd>
                  </div>
                </dl>
                <a class="sh-read" href={`/work/${entry.id}`} data-sheet-read>
                  Read the full case study <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </template>
        ))
      }
    </div>
</Base>

<script>
  import { bootHero } from '../gl/boot';
  import { initInspectToggle } from '../lib/inspect/toggle';
  import { initCards } from '../lib/cards/boot';
  bootHero();
  initInspectToggle();
  initCards();
</script>

<style>
  .hero {
    padding-top: var(--space-m);
    padding-bottom: var(--space-2xl);
  }
  .hero-meta {
    margin-top: var(--space-xl);
    row-gap: var(--space-m);
    align-items: end;
  }
  .statement {
    grid-column: 1 / span 7;
    font-size: var(--step-3);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 560;
    text-wrap: balance;
  }
  .facts {
    grid-column: 9 / -1;
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }
  .facts div,
  .meta div,
  .skills div {
    display: grid;
    gap: var(--space-3xs);
  }
  dd {
    margin: 0;
  }

  .section {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--rule);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  /* Work entries */
  .entry {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: var(--space-m);
    align-items: end;
  }
  .entry + .entry {
    margin-top: var(--space-3xl);
  }
  .entry-visual {
    grid-column: 1 / span 7;
    grid-row: 1;
    display: block;
    position: relative;
    text-decoration: none;
  }
  /* the "Quick look" chip only exists once the card script is on the page */
  .peek {
    display: none;
    position: absolute;
    right: var(--space-2xs);
    bottom: var(--space-2xs);
    padding: 0.15em 0.6em;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    pointer-events: none;
  }
  :global(html[data-cards]) .peek {
    display: block;
  }
  :global(html[data-cards]) .entry-visual {
    cursor: pointer;
  }
  :global(html[data-cards]) .entry-visual:hover .peek {
    border-color: var(--accent);
    color: var(--ink);
  }
  .entry-text {
    grid-column: 9 / -1;
    grid-row: 1;
    display: grid;
    gap: var(--space-s);
    padding-bottom: var(--space-3xs);
  }
  .entry.flip .entry-visual {
    grid-column: 6 / -1;
  }
  .entry.flip .entry-text {
    grid-column: 1 / span 4;
  }
  .entry-text h3 {
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 700;
  }
  .entry-text h3 a {
    text-decoration: none;
  }
  .entry-text h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
  }
  .summary {
    font-size: var(--step-0);
    color: var(--ink-soft);
    max-width: 34ch;
  }
  .meta {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--rule);
  }
  .more {
    color: var(--ink);
    justify-self: start;
  }
  .lab-link {
    margin-top: var(--space-2xl);
  }

  /* About */
  .split {
    row-gap: var(--space-l);
  }
  .lede {
    grid-column: 1 / span 10;
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 560;
    text-wrap: balance;
  }
  .body {
    grid-column: 4 / span 6;
    display: grid;
    gap: var(--space-s);
    max-width: 38rem;
    color: var(--ink-soft);
  }
  .skills {
    grid-column: 10 / -1;
    grid-row: 2;
    display: grid;
    gap: var(--space-s);
    margin: 0;
    align-content: start;
  }
  .now {
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
    row-gap: var(--space-s);
  }
  .now-title {
    grid-column: 1 / span 3;
  }
  .now-list {
    grid-column: 4 / span 6;
    list-style: none;
    display: grid;
  }
  .now-list li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .now-date {
    grid-column: 4 / -1;
    font-size: var(--step--2);
  }

  /* Contact */
  .contact .email {
    grid-column: 1 / -1;
    font-size: clamp(1.3rem, 0.6rem + 5.2vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    overflow-wrap: anywhere;
    text-decoration-thickness: 2px;
  }
  .contact .note {
    grid-column: 1 / span 5;
    color: var(--ink-soft);
  }
  .socials {
    grid-column: 7 / -1;
    list-style: none;
    display: grid;
  }
  .socials a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .socials a:hover span:first-child {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  @media (max-width: 56rem) {
    .statement,
    .facts,
    .lede,
    .body,
    .skills,
    .now-title,
    .now-list,
    .now-date,
    .contact .note,
    .socials {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .skills {
      grid-template-columns: 1fr 1fr;
    }
    .entry-visual,
    .entry-text,
    .entry.flip .entry-visual,
    .entry.flip .entry-text {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .entry-text {
      padding-top: var(--space-xs);
    }
    .summary {
      max-width: 44ch;
    }
  }
  @media (max-width: 30rem) {
    .now-list li {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
  }
</style>
